# LLM API settings for the tennis data-prep example (committed template).
# Copy this file to dev_local.env and fill in your key(s); dev_local.env is gitignored.
#
# Provider: "nvidia" (default) or "openai"
LLM_API_PROVIDER=nvidia

# NVIDIA Inference API — https://inference-api.nvidia.com
# Default model: azure/openai/gpt-5.2
NVIDIA_API_KEY=

# OpenAI API — https://api.openai.com/v1 (https://developers.openai.com/api/docs)
# Default model: gpt-5.2
OPENAI_API_KEY=

# Optional model override (defaults to GPT-5.2 per provider if unset)
# LLM_MODEL=
