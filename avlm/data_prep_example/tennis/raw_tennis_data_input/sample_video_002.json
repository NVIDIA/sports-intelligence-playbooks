        {
          "groupId": 1152669,
          "name": "This is a Gentleman's Singles match between Roger Federer and Julien Benneteau in the third round of the 2012 Wimbledon Championships. The match carries on for five sets, with Roger Federer ultimately winning the match. The players play two tiebreaker sets in the second and fourth sets to settle the score. The final score at the end of the match reads: 4-6, 6-7(3-7), 6-2, 7-6(8-6), 6-1.",
          "groupName": "value_general_context"
        }
      ],
      "element_path": [
